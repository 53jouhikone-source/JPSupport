+procedure TCustomSynEdit.WMImeQueryCaretPos(var Message: TMessage);
+begin
+  // JPSupport (Qt5/Qt6): thin forwarder to the IME handler class, matching
+  // the pattern already used for WMImeComposition etc. on other platforms
+  // (e.g. GTK2's GTK_IMComposition). All the actual logic lives in
+  // LazSynImeQt (lazsynqtimm.pas).
+  if FImeHandler <> nil then
+    FImeHandler.WMImeQueryCaretPos(Message);
+end;
+
+procedure TCustomSynEdit.WMImeSetPreedit(var Message: TMessage);
+begin
+  if FImeHandler <> nil then
+    FImeHandler.WMImeSetPreedit(Message);
+end;
+
