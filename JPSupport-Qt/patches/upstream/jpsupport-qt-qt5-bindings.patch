   FIMPreedit:=FPreEditStr<>'';
+  // JPSupport (Qt6/SynEdit): if we're about to insert committed text while
+  // a preedit block from the PREVIOUS event is still sitting in the real
+  // buffer (as temporary text - see LM_IM_SET_PREEDIT/SetImeTempText),
+  // clear it first. Otherwise the commit's synthetic key presses below
+  // land next to/inside that stale temporary text instead of a clean
+  // caret position, producing garbled/duplicated characters.
+  if (WStr<>'') and WasComposing and (LCLObject <> nil) and (LCLObject is TControl) then
+  begin
+    FillChar(PreeditInfo, SizeOf(PreeditInfo), 0);
+    FillChar(PreeditMsg, SizeOf(PreeditMsg), 0);
