# 001
JPSupport-Qt: Qt5 widgetset bindings only (QInputMethodEvent attributes + LCL slots)

Against: Lazarus main (generated from e5ece2347d, 2026-10-04)
Apply:   git apply jpsupport-qt-qt5-bindings.patch   (or: patch -p1 < ...)

Same change as jpsupport-qt-qt6-bindings.patch, ported to the Qt5 widgetset.

Files:
  lcl/interfaces/qt5/cbindings/src/qevent_c.h / qevent_c.cpp
      New C accessors for QInputMethodEvent::attributes() (count / type /
      start / length / backgroundColor / bold). Read-only wrappers; no
      existing exported symbol is changed. Needs libQt5Pas rebuilt.
  lcl/interfaces/qt5/qt56.pas
      Pascal external declarations for the accessors above.
  lcl/interfaces/qt5/qtwidgets.pas
      TQtWidget.SlotInputMethod: forwards preedit text + segments/cursor
      to the LCL control via LM_IM_SET_PREEDIT; clears any stale preedit
      left from the previous event before inserting committed text.

NOT included (see the other patches in this directory):
  lcl/lmessages.pp  - jpsupport-qt-lmessages.patch (defines
                      LM_IM_SET_PREEDIT and TIMEPreeditInfo;
                      qtwidgets.pas above will not compile without it).
  components/synedit/* - jpsupport-qt-lazsynime-refactor.patch (the
                      consumer side: LazSynIme / LazSynImeQt).
Controls that do not handle these messages (TEdit/QLineEdit) leave
Msg.Result = 0 and keep the previous native Qt behaviour.

diff --git a/lcl/interfaces/qt5/cbindings/src/qevent_c.cpp b/lcl/interfaces/qt5/cbindings/src/qevent_c.cpp
index b54e78ec8b..3651f9f49f 100644
--- a/lcl/interfaces/qt5/cbindings/src/qevent_c.cpp
+++ b/lcl/interfaces/qt5/cbindings/src/qevent_c.cpp
@@ -707,6 +707,64 @@ QInputMethodEventH QInputMethodEvent_Create3(const QInputMethodEventH other)
 	return (QInputMethodEventH) new QInputMethodEvent(*(const QInputMethodEvent*)other);
 }
 
+int QInputMethodEvent_attributeCount(QInputMethodEventH handle)
+{
+	return ((QInputMethodEvent *)handle)->attributes().count();
+}
+
+int QInputMethodEvent_attributeType(QInputMethodEventH handle, int index)
+{
+	const QList<QInputMethodEvent::Attribute> &attrs = ((QInputMethodEvent *)handle)->attributes();
+	if (index < 0 || index >= attrs.count())
+		return -1;
+	return (int) attrs.at(index).type;
+}
+
+int QInputMethodEvent_attributeStart(QInputMethodEventH handle, int index)
+{
+	const QList<QInputMethodEvent::Attribute> &attrs = ((QInputMethodEvent *)handle)->attributes();
+	if (index < 0 || index >= attrs.count())
+		return 0;
+	return attrs.at(index).start;
+}
+
+int QInputMethodEvent_attributeLength(QInputMethodEventH handle, int index)
+{
+	const QList<QInputMethodEvent::Attribute> &attrs = ((QInputMethodEvent *)handle)->attributes();
+	if (index < 0 || index >= attrs.count())
+		return 0;
+	return attrs.at(index).length;
+}
+
+int QInputMethodEvent_attributeBackgroundColor(QInputMethodEventH handle, int index)
+{
+	const QList<QInputMethodEvent::Attribute> &attrs = ((QInputMethodEvent *)handle)->attributes();
+	if (index < 0 || index >= attrs.count())
+		return -1;
+	const QInputMethodEvent::Attribute &attr = attrs.at(index);
+	if (attr.type != QInputMethodEvent::TextFormat)
+		return -1;
+	QTextFormat fmt = attr.value.value<QTextFormat>();
+	QBrush bg = fmt.background();
+	if (bg.style() == Qt::NoBrush)
+		return -1;
+	QColor c = bg.color();
+	return (c.alpha() << 24) | (c.red() << 16) | (c.green() << 8) | c.blue();
+}
+
+int QInputMethodEvent_attributeBold(QInputMethodEventH handle, int index)
+{
+	const QList<QInputMethodEvent::Attribute> &attrs = ((QInputMethodEvent *)handle)->attributes();
+	if (index < 0 || index >= attrs.count())
+		return -1;
+	const QInputMethodEvent::Attribute &attr = attrs.at(index);
+	if (attr.type != QInputMethodEvent::TextFormat)
+		return -1;
+	QTextFormat fmt = attr.value.value<QTextFormat>();
+	QTextCharFormat cfmt = fmt.toCharFormat();
+	return cfmt.font().bold() ? 1 : 0;
+}
+
 QInputMethodQueryEventH QInputMethodQueryEvent_Create(unsigned int queries)
 {
 	return (QInputMethodQueryEventH) new QInputMethodQueryEvent((Qt::InputMethodQueries)queries);
