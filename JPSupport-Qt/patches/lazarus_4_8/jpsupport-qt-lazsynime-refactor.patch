+unit LazSynQtIMM;
+
+{$mode objfpc}{$H+}
+
+interface
+
+uses
+  Classes, SysUtils, Types, Graphics, LCLType, LMessages, Messages,
+  LazSynIMMBase, SynEditMiscClasses, SynEditPointClasses, SynEditMarkupSelection,
+  SynEditMarkup, LazSynEditText, SynEditTypes;
+
+type
+  { LazSynImeQt }
+
+  LazSynImeQt = class(LazSynIme)
+  private
+    FPreeditInfo: TIMEPreeditInfo;
+    // Whole composing (preedit) range, held as real, undo-hidden text -
+    // see SetImeTempText - plus the sub-range of the one currently-focused
+    // bunsetsu (segment), so the two can be styled differently via markup
+    // instead of custom painting. Mirrors LazSynImeFull's approach
+    // (lazsynimm.pas) for Windows, adapted from its 3-selection / COMPATTR
+    // scheme to Qt's single-event TIMEPreeditInfo segment array.
+    FImeBlockSelection: TSynEditSelection;
+    FImeFocusedSelection: TSynEditSelection;
+    FImeMarkup: TSynEditMarkupSelection;
+    FImeFocusedMarkup: TSynEditMarkupSelection;
+    // True while a composition is in progress - used to anchor
+    // FImeBlockSelection to the real caret position exactly once, at the
+    // start of each composition (Qt gives us no separate "start" event;
+    // we detect it ourselves via the Text=''->non-'' transition).
+    FComposing: Boolean;
+    function CharToByte(AStart, AChars: Integer): Integer;
+    procedure SetImeTempText(const S: String);
+  public
+    constructor Create(AOwner: TSynEditBase); reintroduce;
+    destructor Destroy; override;
+    procedure WMImeQuery(var Msg: TMessage); override;
+    procedure WMImeSetPreedit(var Msg: TMessage); override;
+  end;
+
+implementation
+
+{ LazSynImeQt }
+
+constructor LazSynImeQt.Create(AOwner: TSynEditBase);
+begin
+  inherited Create(AOwner);
+
+  FImeBlockSelection := TSynEditSelection.Create(ViewedTextBuffer, False);
+  FImeBlockSelection.InvalidateLinesMethod := @InvalidateLines;
+  FImeFocusedSelection := TSynEditSelection.Create(ViewedTextBuffer, False);
+  FImeFocusedSelection.InvalidateLinesMethod := @InvalidateLines;
+
+  FImeMarkup := TSynEditMarkupSelection.Create(FriendEdit, FImeBlockSelection);
+  FImeFocusedMarkup := TSynEditMarkupSelection.Create(FriendEdit, FImeFocusedSelection);
+  TSynEditMarkupManager(MarkupMgr).AddMarkUp(FImeMarkup);
+  TSynEditMarkupManager(MarkupMgr).AddMarkUp(FImeFocusedMarkup);
+
+  // Whole composing range: a plain, thin, dotted underline - the usual
+  // "not yet committed" convention.
+  FImeMarkup.MarkupInfo.Clear;
+  FImeMarkup.MarkupInfo.FramePriority := MaxInt - 1;
+  FImeMarkup.MarkupInfo.FrameColor := clDefault;
+  FImeMarkup.MarkupInfo.FrameStyle := slsDashed;
+  FImeMarkup.MarkupInfo.FrameEdges := sfeBottom;
+  FImeMarkup.MarkupInfo.FrameAlpha := 255;
+
+  // Currently-focused bunsetsu (segment): selection-like background plus
+  // a solid underline, so it visually stands out from the rest.
+  FImeFocusedMarkup.MarkupInfo.Assign(FriendEdit.SelectedColor);
+  FImeFocusedMarkup.MarkupInfo.FramePriority := MaxInt;
+  FImeFocusedMarkup.MarkupInfo.FrameColor := clDefault;
+  FImeFocusedMarkup.MarkupInfo.FrameStyle := slsDashed;
+  FImeFocusedMarkup.MarkupInfo.FrameEdges := sfeBottom;
+  FImeFocusedMarkup.MarkupInfo.FrameAlpha := 255;
+end;
+
+destructor LazSynImeQt.Destroy;
+begin
+  TSynEditMarkupManager(MarkupMgr).RemoveMarkUp(FImeMarkup);
+  TSynEditMarkupManager(MarkupMgr).RemoveMarkUp(FImeFocusedMarkup);
+  FreeAndNil(FImeMarkup);
+  FreeAndNil(FImeFocusedMarkup);
+  FreeAndNil(FImeBlockSelection);
+  FreeAndNil(FImeFocusedSelection);
+  inherited Destroy;
+end;
+
+// Converts a run of AChars logical characters, starting at byte position
+// AStart, into a byte count - same algorithm as the Windows reference
+// (LazSynImeFull.WMImeComposition's local CharToByte in lazsynimm.pas).
+function LazSynImeQt.CharToByte(AStart, AChars: Integer): Integer;
+var
+  CWidth: TPhysicalCharWidths;
+begin
+  CWidth := ViewedTextBuffer.GetPhysicalCharWidths(FImeBlockSelection.StartLinePos - 1);
+  Dec(AStart);
+  Result := AStart;
+  while (AChars > 0) and (Result < Length(CWidth)) do
+  begin
+    Inc(Result);
+    while (Result < Length(CWidth)) and ((CWidth[Result] and PCWMask) = 0) do
+      Inc(Result);
+    Dec(AChars);
+  end;
+  Result := Result - AStart + AChars;
+end;
+
+// Inserts S as real text at FImeBlockSelection, with Undo/Redo locked so
+// this temporary, not-yet-committed text never shows up as an Undo step -
+// same approach as LazSynImeFull.SetImeTempText (lazsynimm.pas).
+procedure LazSynImeQt.SetImeTempText(const S: String);
+var
+  P1, P2: TPoint;
+begin
+  P1 := FImeBlockSelection.FirstLineBytePos;
+  ViewedTextBuffer.UndoList.Lock;
+  ViewedTextBuffer.RedoList.Lock;
+  FImeBlockSelection.SelText := S;
+  ViewedTextBuffer.UndoList.Unlock;
+  ViewedTextBuffer.RedoList.Unlock;
+  P2 := FImeBlockSelection.FirstLineBytePos;
+  FImeBlockSelection.StartLineBytePos := P1;
+  FImeBlockSelection.EndLineBytePos := P2;
+end;
+
+procedure LazSynImeQt.WMImeQuery(var Msg: TMessage);
+var
+  P: PPoint;
+begin
+  // Answers the existing LM_IM_QUERY (see TQtWidget.SlotInputMethodQuery,
+  // lcl/interfaces/qt5+qt6/qtwidgets.pas): just the caret's pixel
+  // position. Qt itself builds the candidate-window rectangle from this
+  // point, so there is no caret-width guesswork on our side.
+  P := PPoint(Msg.LParam);
+  if P = nil then
+    Exit;
+  P^.X := FriendEdit.CaretXPix;
+  P^.Y := FriendEdit.CaretYPix;
+  Msg.Result := 1;
+end;
+
+procedure LazSynImeQt.WMImeSetPreedit(var Msg: TMessage);
+var
+  Info: PIMEPreeditInfo;
+  Utf8Text: String;
+  i, FocStart, FocEnd, X: Integer;
+  HasFocus: Boolean;
+  P: TPoint;
+begin
+  Info := PIMEPreeditInfo(Msg.LParam);
+  if Info = nil then
+    Exit;
+  FPreeditInfo := Info^;
+  Utf8Text := UTF8Encode(FPreeditInfo.Text);
+
+  if Utf8Text = '' then
+  begin
+    // Composition ended (committed or cancelled): drop the temporary
+    // text and collapse the focused-segment range to nothing.
+    SetImeTempText('');
+    if FComposing then
+      CaretObj.LineBytePos := FImeBlockSelection.StartLineBytePos;
+    FImeFocusedSelection.StartLineBytePos := FImeBlockSelection.StartLineBytePos;
+    FImeFocusedSelection.EndLineBytePos := FImeBlockSelection.StartLineBytePos;
+    FComposing := False;
+    Msg.Result := 1;
+    Exit;
+  end;
+
+  // Starting a new composition (previous call had empty text, or this is
+  // the very first one): anchor the block at the real caret position -
+  // otherwise FImeBlockSelection stays wherever it last was (its
+  // just-created default, (1,1), the first time), and the temporary text
+  // would be inserted there instead of where the user is actually typing.
+  if not FComposing then
+  begin
+    FImeBlockSelection.StartLineBytePos := CaretObj.LineBytePos;
+    FImeBlockSelection.EndLineBytePos := CaretObj.LineBytePos;
+    FComposing := True;
+  end;
+
+  SetImeTempText(Utf8Text);
+
+  // Merge all Focused segments into one range (normally there is exactly
+  // one focused bunsetsu, but merge defensively if more are reported) -
+  // same idea as the Windows reference merging ATTR_TARGET_CONVERTED runs.
+  HasFocus := False;
+  FocStart := 0;
+  FocEnd := 0;
+  for i := 0 to FPreeditInfo.SegmentCount - 1 do
+  begin
+    if not FPreeditInfo.Segments[i].Focused then
+      Continue;
+    if (FPreeditInfo.Segments[i].Start < 0) or (FPreeditInfo.Segments[i].Length <= 0) then
+      Continue;
+    if not HasFocus then
+    begin
+      FocStart := FPreeditInfo.Segments[i].Start;
+      FocEnd := FocStart + FPreeditInfo.Segments[i].Length;
+      HasFocus := True;
+    end
+    else
+    begin
+      if FPreeditInfo.Segments[i].Start < FocStart then
+        FocStart := FPreeditInfo.Segments[i].Start;
+      if FPreeditInfo.Segments[i].Start + FPreeditInfo.Segments[i].Length > FocEnd then
+        FocEnd := FPreeditInfo.Segments[i].Start + FPreeditInfo.Segments[i].Length;
+    end;
+  end;
+
+  X := FImeBlockSelection.StartBytePos;
+  if HasFocus then
+  begin
+    P := FImeBlockSelection.StartLineBytePos;
+    P.X := X + CharToByte(X, FocStart);
+    FImeFocusedSelection.StartLineBytePos := P;
+    P.X := X + CharToByte(X, FocEnd);
+    FImeFocusedSelection.EndLineBytePos := P;
+  end
+  else
+  begin
+    FImeFocusedSelection.StartLineBytePos := FImeBlockSelection.StartLineBytePos;
+    FImeFocusedSelection.EndLineBytePos := FImeBlockSelection.StartLineBytePos;
+  end;
+
+  // Move the real caret to the IME-reported cursor position within the
+  // composing text - reuses SynEdit's own (blinking) caret instead of
+  // hiding it behind a custom-painted one.
+  if FPreeditInfo.CursorVisible and (FPreeditInfo.CursorPos >= 0) then
+    CaretObj.CharPos := ViewedTextBuffer.LogicalToPhysicalPos(
+      Point(X + CharToByte(X, FPreeditInfo.CursorPos), FImeBlockSelection.StartLinePos)).x;
+
+  Msg.Result := 1;
+end;
+
+end.
